# ---------------------------------------------------------------------------
# Mapua School OS — environment template
#
# Names only. Never commit real values; never paste a Blackboard feed URL or a
# Notion token into this file. Copy to .env.local for development.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Public origin of the deployment. Used for magic-link and OAuth redirects, and
# for the calendar feed URL shown in Settings.
APP_URL=

# PostgreSQL connection string. Leave empty to use the bundled PGlite database
# in .data/pglite (development and tests only — never production).
DATABASE_URL=
DATABASE_POOL_MAX=
# Set to "require" to demand a verified TLS connection to Postgres.
DATABASE_SSL=
# Only used when DATABASE_URL is empty.
PGLITE_DATA_DIR=

# --- Secret encryption (required in production) ------------------------------
# Comma-separated keyring: <keyId>:<base64 of 32 random bytes>. Generate with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# Rotation: add a new key, point ACTIVE_KEY_ID at it, redeploy. Old ciphertexts
# keep decrypting under their own key id and are re-encrypted as they are read.
SECRET_ENCRYPTION_KEYS=
SECRET_ENCRYPTION_ACTIVE_KEY_ID=

# --- Mail (magic-link sign-in) ----------------------------------------------
# Any provider that accepts a JSON POST of {from,to,subject,text}. When unset,
# the console transport prints the link to the server log and the UI says
# plainly that no mail was sent.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
MAIL_FROM=

# --- Web Push ---------------------------------------------------------------
# Generate a VAPID pair with:  npx web-push generate-vapid-keys
# When unset, notifications are still recorded in-app and the UI reports that
# push delivery is not configured rather than pretending to deliver.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Attachment storage -----------------------------------------------------
# S3-compatible (AWS S3, Cloudflare R2, MinIO). When unset, files are stored on
# the local filesystem under LOCAL_STORAGE_DIR, which is fine for a single-node
# deployment with a persistent volume.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "false" switches to virtual-hosted-style addressing.
S3_FORCE_PATH_STYLE=
LOCAL_STORAGE_DIR=
MAX_ATTACHMENT_BYTES=

# --- Blackboard -------------------------------------------------------------
# Optional institution pinning: a comma-separated host allowlist that feed URLs
# must match. Strongly recommended in a managed deployment.
FEED_HOST_ALLOWLIST=
FEED_MAX_BYTES=
FEED_TIMEOUT_MS=
BLACKBOARD_POLL_INTERVAL_MS=
# Development only. Allows plain http feed URLs; never enable in production.
ALLOW_INSECURE_FEED_URLS=

# --- Notion -----------------------------------------------------------------
# From your Notion integration's OAuth settings. The redirect URI must match
# exactly, including the scheme and any port.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=

# --- Scheduled drain (only for hosts without a long-lived worker) -----------
# When set, GET /api/cron/drain runs one batch of queued jobs. The scheduler
# must send `Authorization: Bearer <this value>`. Leave empty when running the
# worker process, which is the better arrangement.
CRON_SECRET=

# --- Seed / demo ------------------------------------------------------------
# Email address the seed script creates. Defaults to demo@school.local.
DEMO_EMAIL=

# --- Local AI bridge (runs on the student's machine, not the server) --------
# These are read by bridge/school-os-bridge.mjs, never by the server.
#   SCHOOL_OS_URL=https://your-app.example.com
#   OLLAMA_URL=http://127.0.0.1:11434
#   OPENAI_BASE_URL=
#   OPENAI_API_KEY=
#   BRIDGE_MODEL=llama3.1:8b
#   BRIDGE_PORT=4319
