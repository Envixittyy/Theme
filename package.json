{
  "name": "mapua-school-os",
  "version": "0.4.0",
  "private": true,
  "description": "Mapua School OS \u2014 an academic productivity workspace: tasks, calendar, courses, Blackboard + Notion sync, notifications, offline PWA, optional local AI.",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx src/lib/jobs/worker-main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:reset": "tsx src/lib/db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "check": "npm run typecheck && npm test && node --check bridge/school-os-bridge.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.7",
    "drizzle-orm": "0.45.2",
    "idb": "8.0.3",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  }
}
